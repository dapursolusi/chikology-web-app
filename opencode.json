{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "sumopod": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SumoPod AI Router",
      "options": {
        "baseURL": "{env:SUMOPOD_BASE_URL}",
        "apiKey": "{env:SUMOPOD_API_KEY}"
      },
      "models": {
        "MiniMax-M2.7-highspeed": { "name": "MiniMax M2.7 Highspeed" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "glm-5.1": { "name": "GLM 5.1" }
      }
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["bunx", "--bun", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["bunx", "--bun", "next-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
